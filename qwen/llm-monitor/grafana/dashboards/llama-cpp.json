{
  "uid": "llamacpp-qwen",
  "title": "llama.cpp · Qwen3.8-27B (qwen-local)",
  "tags": ["llamacpp", "qwen", "engine"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "editable": true,
  "time": {"from": "now-3h", "to": "now"},
  "panels": [
    {
      "id": 1, "type": "stat", "title": "当前并发请求",
      "datasource": {"type": "prometheus", "uid": "vllm-prom"},
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0},
      "targets": [{"refId": "A", "expr": "llamacpp:requests_processing", "legendFormat": "processing"}],
      "fieldConfig": {"defaults": {"unit": "none", "decimals": 0}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "value", "graphMode": "area"}
    },
    {
      "id": 2, "type": "stat", "title": "排队等待",
      "datasource": {"type": "prometheus", "uid": "vllm-prom"},
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0},
      "targets": [{"refId": "A", "expr": "llamacpp:requests_deferred", "legendFormat": "deferred"}],
      "fieldConfig": {"defaults": {"unit": "none", "decimals": 0, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 1}, {"color": "red", "value": 4}]}}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "background", "graphMode": "none"}
    },
    {
      "id": 3, "type": "stat", "title": "Decode 速度 (tok/s)",
      "datasource": {"type": "prometheus", "uid": "vllm-prom"},
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 0},
      "targets": [{"refId": "A", "expr": "llamacpp:predicted_tokens_seconds", "legendFormat": "tok/s"}],
      "fieldConfig": {"defaults": {"unit": "none", "decimals": 1}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "value", "graphMode": "area"}
    },
    {
      "id": 4, "type": "stat", "title": "Prefill 速度 (tok/s)",
      "datasource": {"type": "prometheus", "uid": "vllm-prom"},
      "gridPos": {"h": 4, "w": 6, "x": 18, "y": 0},
      "targets": [{"refId": "A", "expr": "llamacpp:prompt_tokens_seconds", "legendFormat": "tok/s"}],
      "fieldConfig": {"defaults": {"unit": "none", "decimals": 0}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "value", "graphMode": "area"}
    },
    {
      "id": 5, "type": "timeseries", "title": "Token 吞吐",
      "datasource": {"type": "prometheus", "uid": "vllm-prom"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4},
      "targets": [
        {"refId": "A", "expr": "sum(rate(llamacpp:tokens_predicted_total[2m]))", "legendFormat": "decode tok/s"},
        {"refId": "B", "expr": "sum(rate(llamacpp:prompt_tokens_total[2m]))", "legendFormat": "prefill tok/s"}
      ],
      "fieldConfig": {"defaults": {"unit": "none", "custom": {"drawStyle": "line", "fillOpacity": 12}}, "overrides": []}
    },
    {
      "id": 6, "type": "timeseries", "title": "MTP 投机解码接受率",
      "datasource": {"type": "prometheus", "uid": "vllm-prom"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4},
      "targets": [
        {"refId": "A", "expr": "sum(rate(llamacpp:spec_decode_num_accepted_tokens_total[5m])) / clamp_min(sum(rate(llamacpp:spec_decode_num_draft_tokens_total[5m])), 0.001)", "legendFormat": "总接受率"},
        {"refId": "B", "expr": "sum(rate(llamacpp:spec_decode_num_accepted_tokens_per_pos_total{position=\"0\"}[5m])) / clamp_min(sum(rate(llamacpp:spec_decode_num_drafts_total[5m])), 0.001)", "legendFormat": "位置1"},
        {"refId": "C", "expr": "sum(rate(llamacpp:spec_decode_num_accepted_tokens_per_pos_total{position=\"1\"}[5m])) / clamp_min(sum(rate(llamacpp:spec_decode_num_drafts_total[5m])), 0.001)", "legendFormat": "位置2"},
        {"refId": "D", "expr": "sum(rate(llamacpp:spec_decode_num_accepted_tokens_per_pos_total{position=\"2\"}[5m])) / clamp_min(sum(rate(llamacpp:spec_decode_num_drafts_total[5m])), 0.001)", "legendFormat": "位置3"}
      ],
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1, "custom": {"drawStyle": "line", "fillOpacity": 8}}, "overrides": []}
    },
    {
      "id": 7, "type": "timeseries", "title": "前缀缓存命中率 (prompt cache)",
      "datasource": {"type": "prometheus", "uid": "vllm-prom"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 12},
      "targets": [
        {"refId": "A", "expr": "sum(rate(llamacpp:prompt_tokens_cached_total[10m])) / clamp_min(sum(rate(llamacpp:prompt_tokens_total[10m])), 0.001)", "legendFormat": "命中率"}
      ],
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1, "custom": {"drawStyle": "line", "fillOpacity": 15}}, "overrides": []}
    },
    {
      "id": 8, "type": "timeseries", "title": "平均每 token 解码耗时 (ms)",
      "datasource": {"type": "prometheus", "uid": "vllm-prom"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 12},
      "targets": [
        {"refId": "A", "expr": "1000 * sum(rate(llamacpp:tokens_predicted_seconds_total[5m])) / clamp_min(sum(rate(llamacpp:tokens_predicted_total[5m])), 0.001)", "legendFormat": "ms/token"}
      ],
      "fieldConfig": {"defaults": {"unit": "ms", "custom": {"drawStyle": "line", "fillOpacity": 8}}, "overrides": []}
    },
    {
      "id": 9, "type": "stat", "title": "上下文容量 (tokens)",
      "datasource": {"type": "prometheus", "uid": "vllm-prom"},
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 20},
      "targets": [{"refId": "A", "expr": "llamacpp:n_tokens_max", "legendFormat": "max"}],
      "fieldConfig": {"defaults": {"unit": "none", "decimals": 0}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "value", "graphMode": "none"}
    },
    {
      "id": 10, "type": "timeseries", "title": "槽位忙碌度 (n_busy_slots)",
      "datasource": {"type": "prometheus", "uid": "vllm-prom"},
      "gridPos": {"h": 4, "w": 18, "x": 6, "y": 20},
      "targets": [{"refId": "A", "expr": "llamacpp:n_busy_slots_per_decode", "legendFormat": "busy slots"}],
      "fieldConfig": {"defaults": {"unit": "none", "custom": {"drawStyle": "bars", "fillOpacity": 40}}, "overrides": []}
    }
  ]
}
